# =======================================================================
# ARISP – Comprehensive Root .gitignore
# =======================================================================

# -----------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
Desktop.ini

# -----------------------------------------------------------------------
# IDE and Editors
# -----------------------------------------------------------------------
# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.suo
*.suo.tmp

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.history/
*.code-workspace

# JetBrains (Rider, WebStorm, etc.)
.idea/
*.iws
out/
_ReSharper*/
*.user.*

# Text Editors / General
*~
*.swp
*.swo
.lock-wscript

# -----------------------------------------------------------------------
# Claude Code (local settings chứa secrets – không commit)
# -----------------------------------------------------------------------
.claude/settings.local.json
.claude/settings.local.json.bak*

# -----------------------------------------------------------------------
# Environment Files & Secrets (MUST NEVER BE COMMITTED)
# -----------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local
docker/.env
!docker/.env.example
ari-web/src/*/.env
!ari-web/src/*/.env.example

# Dữ liệu của container Postgres chạy local (bind mount PGDATA_PATH=./pgdata — ADR-055).
# Là thư mục dữ liệu thật của Postgres: không bao giờ commit.
docker/pgdata/

# Google OAuth credentials for MCP (Docs/Drive) – NEVER commit
.secrets/

# -----------------------------------------------------------------------
# Node.js & React Frontend (Vite / npm)
# -----------------------------------------------------------------------
# Dependencies
node_modules/
jspm_packages/
web_modules/

# Production / Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Frontend Testing / Tooling caches
coverage/
.eslintcache
.stylelintcache
.tsbuildinfo
.npm/
.parcel-cache/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history

# -----------------------------------------------------------------------
# .NET / C# Backend
# -----------------------------------------------------------------------
# Build folders (case-insensitive for safety, standard ignores)
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
_ReSharper.**/
**/appsettings.Development.json
**/appsettings.Production.json
**/appsettings.Staging.json
**/appsettings.*.Local.json

# EF Core & Migration artifacts
*.db-journal
*.db-shm
*.db-wal

# -----------------------------------------------------------------------
# Uploads / Static Media Files (CVs, images, etc.)
# -----------------------------------------------------------------------
**/uploads/



# -----------------------------------------------------------------------
# Sơ đồ nghiệp vụ (.drawio) – không đưa lên git.
# Tài liệu vận hành trong docs/ VẪN được track như cũ.
# -----------------------------------------------------------------------
docs/diagrams/
