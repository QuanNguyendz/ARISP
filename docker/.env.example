# ============================================================
# ARISP – Biến môi trường cho Docker Compose
#
# Cách dùng:  cp docker/.env.example docker/.env  rồi điền giá trị thật.
# docker/.env đã nằm trong .gitignore — KHÔNG commit secret.
#
# ⚠️ HAI HỆ TÊN BIẾN KHÁC NHAU trong cùng file này:
#   1. Backend .NET  → dùng dấu `__` ánh xạ sang IConfiguration
#                      (vd Authentication__Google__ClientId → Authentication:Google:ClientId)
#   2. rag-service Python (ADR-039) → dùng UPPER_SNAKE_CASE phẳng
#                      (DATABASE_*, OPENAI_API_KEY, APP_ENV)
#
# Không suy ra được của nhau. Trên prod từng thiếu DATABASE_* và OPENAI_API_KEY
# khiến arisp-rag crash-loop ~6900 lần rồi chạy mock mode (sinh câu hỏi giả) —
# giữ nguyên cả hai nhóm khi tạo môi trường mới.
# ============================================================

# --- Môi trường ---
ASPNETCORE_ENVIRONMENT=Production

# --- Tag image kéo từ GHCR (CI/CD đặt = git sha; bỏ trống = "dev" build local) ---
# IMAGE_TAG=

# ============================================================
# 1. DATABASE — Postgres tự host trên chính VPS (ADR-055, thay Supabase)
#
# ⚠️ MẬT KHẨU PHẢI GIỐNG NHAU Ở CẢ 3 CHỖ dưới đây:
#   1a. POSTGRES_PASSWORD                   → khởi tạo chính container postgres
#   1b. ConnectionStrings__DefaultConnection → backend .NET đọc
#   1c. DATABASE_PASSWORD                    → rag-service Python đọc
# Lệch một chỗ là service tương ứng không nối được DB.
# ============================================================

# 1a. Container postgres (docker-compose.yml). Prod BẮT BUỘC đặt, không để trống
# — bỏ trống thì rơi về default `password123` của máy dev.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<mat-khau-manh>
POSTGRES_DB=arisp_db

# Nơi đặt dữ liệu Postgres trên host (bind mount, không phải named volume — để
# `docker compose down -v` không xoá được). Linux/VPS giữ mặc định là đủ;
# máy dev Windows/macOS đặt PGDATA_PATH=./pgdata.
# PGDATA_PATH=/var/lib/arisp/pgdata

# 1b. Backend .NET — `Host=postgres` là TÊN SERVICE trong arisp-network.
# SSL Mode=Disable: container không phục vụ certificate, để `Require` như chuỗi
# Supabase cũ sẽ làm mọi kết nối chết ngay lúc boot. Traffic không rời host.
ConnectionStrings__DefaultConnection="Host=postgres;Port=5432;Database=arisp_db;Username=postgres;Password=<mat-khau-manh>;SSL Mode=Disable"

# 1c. rag-service Python — BẮT BUỘC, đọc riêng, KHÔNG đọc chuỗi .NET ở trên.
# Dùng tham số rời thay vì DATABASE_URL để password chứa ký tự đặc biệt (?, @, #)
# không làm vỡ DSN — xem rag-service/app/core/db.py.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=arisp_db
DATABASE_USER=postgres
DATABASE_PASSWORD=<mat-khau-manh>
DATABASE_SSLMODE=disable

# --- Môi trường TEST (Supabase) — không dùng cho production ---
# Supabase nay chỉ còn là môi trường test/integration. Muốn trỏ tạm sang đó thì
# thay 1b + 1c bằng chuỗi pooler và đặt lại SSL Mode=Require / sslmode=require:
#   Host=<region>.pooler.supabase.com;Port=5432;Database=postgres;
#   Username=postgres.<project-ref>;SSL Mode=Require;Trust Server Certificate=true

# ============================================================
# 2. AI / LLM
# ============================================================

# 2a. Backend .NET — GPT-4o cho phỏng vấn (ADR-004)
AI__OpenAI__ApiKey=sk-proj-xxxxxxxx

# 2b. rag-service Python — CÙNG key nhưng tên biến khác.
# Thiếu biến này → use_mock=True, service sinh câu hỏi/đánh giá GIẢ mà vẫn
# trả HTTP 200 (rag-service/app/config.py:46) — rất khó phát hiện.
OPENAI_API_KEY=sk-proj-xxxxxxxx
APP_ENV=production

# 2c. Gemini 2.5 Flash — CV-JD Analysis + trích xuất JD (ADR-030, ADR-042)
GEMINI_API_KEY=<gemini-api-key>

# 2d. URL nội bộ tới RAG microservice (ADR-039)
RAG_SERVICE_URL=http://rag-service:8000

# ============================================================
# 3. AUTH
# ============================================================
JWT__Secret=<chuoi-ngau-nhien-toi-thieu-32-ky-tu>
Authentication__Google__ClientId=<client-id>.apps.googleusercontent.com
Authentication__Google__ClientSecret=<client-secret>

# Hai origin FE tách biệt (ADR-046) — cũng chính là nguồn danh sách CORS **và mọi link trong email**.
#
# BẮT BUỘC ở môi trường non-Development: thiếu một trong hai thì **backend không khởi động**
# (`DependencyInjection.AddWebServices`). Cố ý như vậy: nếu cho chạy tiếp với giá trị mặc định, thư
# gửi từ server thật sẽ mang nút bấm dẫn về localhost — không lỗi, không log, chỉ phát hiện khi ứng
# viên báo link hỏng.
Authentication__AdminFrontendUrl="https://staff.arisp.io.vn"
Frontend__CandidateBaseUrl="https://arisp.io.vn"

# ============================================================
# 4. EMAIL (magic link, thông báo kết quả)
# ============================================================
EmailSettings__SmtpServer="smtp.gmail.com"
EmailSettings__SmtpPort="587"
EmailSettings__SenderEmail=<email>
EmailSettings__SenderName="ARISP Team Support"
EmailSettings__AppPassword=<app-password>

# ============================================================
# 5. FILE STORAGE (ADR-036) — Local (dev) / Cloudflare R2 (prod)
# ============================================================
Storage__Provider="S3"
Storage__S3__Endpoint="https://<account-id>.r2.cloudflarestorage.com"
Storage__S3__Bucket="arisp-uploads"
Storage__S3__Region="auto"
# Prefix gốc tuỳ chọn cho cả bucket (vd "prod" khi dùng chung bucket giữa các môi trường).
# Để RỖNG là mặc định — không phải nơi phân loại file. Loại file tự vào cv/ jd/ recordings/ playbooks/.
Storage__S3__KeyPrefix=
Storage__S3__AccessKeyId=<access-key-id>
Storage__S3__SecretAccessKey=<secret-access-key>

# ============================================================
# 6. MEDIA PIPELINE (ADR-005, ADR-043, ADR-044)
# Thiếu key → BE fallback mềm: không STT thì ứng viên gõ tay, không TTS thì dùng giọng trình duyệt.
# Avatar (HeyGen LiveAvatar) ĐÃ GỠ khỏi dự án ở ADR-067 — không còn biến Media__HeyGen__* nào.
# ============================================================
Media__Deepgram__ApiKey=<deepgram-key>
Media__ElevenLabs__ApiKey=<elevenlabs-key>
Media__ElevenLabs__DefaultVoiceId=<voice-id>

# ============================================================
# 7. PHỎNG VẤN THỬ (Practice) — ADR-050
# Buổi thử và buổi thật đều audio-only (ADR-050 mở rộng ở ADR-067 — avatar đã gỡ).
# Trần thời lượng 20' → hết giờ AI nói câu kết rồi dừng.
# ============================================================
Interview__PracticeAttemptsPerRound=1
Interview__PracticeMaxDurationMinutes=20

# Buổi THẬT (ADR-052): trần độ dài buổi phỏng vấn, thuần quyết định nghiệp vụ — con số 20'
# vốn lấy theo gói avatar, mà avatar đã gỡ (ADR-067) nên đổi được tự do.
Interview__RealMaxDurationMinutes=20
